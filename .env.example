GID=1000
UID=1000

PRODUCTION=false
PYTHONUNBUFFERED=1

APP_PORT=5008
FRONT_PORT=3008
FLOWER_PORT=5555

# Public frontend (Traefik Host rule in docker-compose.dev.yml)
PUBLIC_URL=dev.ir

# Public API hostname (Traefik Host rule for the FastAPI service)
BACKEND_BASE_URL=api.dev.ir

# Browser fetch + EventSource — public API origin (HTTPS behind Traefik)
NEXT_PUBLIC_API_URL=https://api.dev.ir

# Local dev without Traefik (uncomment):
# NEXT_PUBLIC_API_URL=http://localhost:5008

# Required here for Flower’s command and for Celery apps (Compose merges into containers)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
