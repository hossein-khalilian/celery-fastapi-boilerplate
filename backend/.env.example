# Backend (FastAPI + Celery worker) — copy to backend/.env
# Docker Compose merges this with the project root .env for backend, worker, and flower.

# Base URL the Celery worker uses to POST /webhook/inbox/{token}
# Docker internal DNS (recommended when worker and API share a network):
WEBHOOK_CALLBACK_BASE=http://backend:5000

# Redis DB for webhook inbox + SSE pub/sub (default DB 2; broker/result use 0/1 in celery_app)
WEBHOOK_REDIS_URL=redis://redis:6379/2

# If the worker cannot resolve the backend service, use the public API:
# WEBHOOK_CALLBACK_BASE=https://api.dev.ir

# Optional: comma-separated browser origins (defaults to * if unset)
CORS_ORIGINS=https://dev.ir,https://www.dev.ir
